{
  "rules": {
    "restaurants": {
      ".read": true,
      "$id": {
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "restaurantRatings": {
      ".read": true,
      ".write": true
    },
    "restaurantReviews": {
      ".read": true,
      ".write": true
    },
    "editRequests": {
      ".read": true,
      "$requestId": {
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "analytics": {
      ".read": true,
      ".write": true
    },
    "meta": {
      ".read": true,
      ".write": true
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "userProfiles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "reviews": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "oneLineReviews": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "config": {
      ".read": false,
      ".write": false
    }
  }
}
